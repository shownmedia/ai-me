# Your Slack app's tokens (see README: "Create the Slack app")
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Who the bot works for. Only this Slack user can give it tasks.
OWNER_SLACK_ID=U...
OWNER_NAME="Your Name"
BOT_NAME="AI You"

# Optional
# CLAUDE_BIN=/path/to/claude          # default: the `claude` on your login shell PATH
# WORKDIR=~                           # where Claude Code starts each task
# DEFAULT_MODEL=sonnet                # newest Sonnet; say "use opus" in a message to switch that thread
# OPUS_MODEL=opus                     # what "use opus" switches to, e.g. opus[1m] for the 1M-context Opus
# CHROME=1                            # Claude in Chrome (your logged-in browser) in every run; 0 turns it off
# AUTO_MODEL=1                        # first run in a thread picks Sonnet or Opus from the task; 0 = always DEFAULT_MODEL
# LESSONS_HOUR=21                     # daily DM of lessons from threads where you corrected it; off to disable
# PERMISSION_MODE=bypassPermissions   # or: auto, acceptEdits
# TIMEOUT_MIN=60                      # awake-time limit per run
# MAX_BUDGET_USD=                     # per-run cap (API billing only)
# CATCHUP_MIN=5                       # how often to scan for messages missed while offline
# DENY_EMOJI=no_entry_sign           # reaction added when someone else asks it for something
# WORKING_EMOJI=eyes                 # reaction while a task is running (removed when it finishes)
# FINISHED_EMOJI=white_check_mark     # reaction when a task finishes OK (failures get ⚠️)
# DONE_EMOJI=                        # extra reaction next to FINISHED_EMOJI when a task finishes (a custom emoji name)
# MAX_PARALLEL=3                      # how many tasks (in different threads) run at once
# Pulls new code from shownmedia/ai-me while idle and restarts on it (0 turns it off)
AUTO_UPDATE=1
# SLACK_USER_TOKEN=xoxp-...         # your user token (user scope chat:write): lets Clean Up delete your asks
# CLEANUP_AFTER_MIN=60                # fold a finished conversation into one summary this long after its last activity; off to only clean on "clean up"
# LOWERCASE=1                         # write every Slack message in lowercase (code, links and mentions untouched)
# COMMS_LINKS=label|url;label|url     # if set, anyone typing !comms gets these links back (no Claude run, instant)
# COMMS_THREAD_LINKS=label|url        # !comms in a channel: "messages should be in threads" (COMMS_THREAD_TEXT overrides the wording)
# COMMS_DM_LINKS=label|url            # !comms in a DM / group DM: "work talk goes in channels" (COMMS_DM_TEXT overrides the wording)
# COMMS_LINK_URL=                     # older single-link form, used only when COMMS_LINKS is empty
# COMMS_LINK_LABEL=comms-guidelines   # link text for COMMS_LINK_URL
